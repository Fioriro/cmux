diff --git a/Sources/App/MainWindowPin.swift b/Sources/App/MainWindowPin.swift
new file mode 100644
index 00000000..8d03d7f6
--- /dev/null
+++ b/Sources/App/MainWindowPin.swift
@@ -0,0 +1,45 @@
+import AppKit
+import Observation
+
+/// Owned by one terminal window. Titlebar views may outlive their attachment.
+@MainActor
+@Observable
+final class MainWindowPin {
+    @ObservationIgnored private weak var window: NSWindow?
+    private(set) var isPinned = false
+    @ObservationIgnored private var isInFullScreen = false
+
+    init(window: NSWindow) {
+        self.window = window
+    }
+
+    static func actionLabel(isPinned: Bool) -> String {
+        isPinned
+            ? String(localized: "titlebar.unpinWindow", defaultValue: "Unpin Window")
+            : String(localized: "titlebar.pinWindow", defaultValue: "Pin Window")
+    }
+
+    func toggle() {
+        guard let window else { return }
+        isPinned.toggle()
+        if !isInFullScreen {
+            window.level = isPinned ? .floating : .normal
+        }
+        AppDelegate.shared?.restorePeerLevelIfUnneeded()
+    }
+
+    func setFullScreen(_ fullScreen: Bool) {
+        isInFullScreen = fullScreen
+        if isPinned {
+            window?.level = fullScreen ? .normal : .floating
+        }
+    }
+
+    func detach() {
+        if isPinned && !isInFullScreen {
+            window?.level = .normal
+        }
+        window = nil
+        isPinned = false
+    }
+}
diff --git a/Sources/App/NSWindow+CmuxPeerWindow.swift b/Sources/App/NSWindow+CmuxPeerWindow.swift
index 09a6b017..39b56909 100644
--- a/Sources/App/NSWindow+CmuxPeerWindow.swift
+++ b/Sources/App/NSWindow+CmuxPeerWindow.swift
@@ -1,29 +1,41 @@
 import AppKit
 
+@MainActor
+final class CmuxPeerWindowLevels {
+    private weak var raisedPeer: NSWindow?
+    private static let presentedLevel = NSWindow.Level(rawValue: NSWindow.Level.floating.rawValue + 1)
+
+    /// Only the presented peer needs to clear a pinned terminal. Sheets follow
+    /// their parent and windows with their own level (e.g. a HUD) keep it.
+    func present(_ window: NSWindow?, overPinnedTerminal: Bool) {
+        let peer = window?.sheetParent ?? window
+        if !overPinnedTerminal || peer !== raisedPeer {
+            restore()
+        }
+        guard overPinnedTerminal, let peer, raisedPeer !== peer,
+              !(peer is CmuxMainWindow), peer.parent == nil, !peer.isSheet,
+              peer.styleMask.contains(.titled), !peer.styleMask.contains(.fullScreen),
+              peer.level == .normal else { return }
+        raisedPeer = peer
+        peer.level = Self.presentedLevel
+    }
+
+    func restore() {
+        if let raisedPeer, raisedPeer.level == Self.presentedLevel {
+            raisedPeer.level = .normal
+        }
+        raisedPeer = nil
+    }
+}
+
 extension NSWindow {
-    /// Configures this window as a standard cmux top-level *peer* window.
-    ///
-    /// Peer windows — Settings, the Config editor, About — sit at
-    /// `NSWindow.Level.normal` and obey standard macOS window ordering: clicking
-    /// any sibling window (including the main terminal window) brings it forward
-    /// and lets the peer recede behind it. This is the default every top-level
-    /// window the user opens should adopt.
-    ///
-    /// It exists as a single, greppable seam so that "this is an ordinary
-    /// top-level window" is stated explicitly rather than left implicit. The
-    /// only sanctioned way to float a window above its siblings is to set
-    /// `level = .floating` deliberately at the call site with a comment
-    /// justifying it (e.g. DEBUG HUD/lab panels). Accidentally inheriting a
-    /// floating level — via an `NSPanel` default or a stray `level = .floating`
-    /// — is what produced the "Settings floats above the main window forever"
-    /// bug (https://github.com/manaflow-ai/cmux/issues/5081).
-    ///
-    /// - Note: A plain `NSWindow` / SwiftUI `Window` scene already defaults to
-    ///   `.normal`; calling this makes the invariant explicit and guards against
-    ///   a later change (or a child-window attachment) silently re-floating the
-    ///   window.
+    /// Settings and Config adopt ordinary peer ordering at presentation time.
     @MainActor
     func adoptCmuxPeerWindowLevel() {
-        level = .normal
+        if let delegate = AppDelegate.shared {
+            delegate.presentPeerWindow(self, normalizeLevel: true)
+        } else {
+            level = .normal
+        }
     }
 }
