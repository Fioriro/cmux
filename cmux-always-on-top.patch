diff --git a/cmuxTests/MainWindowPinTests.swift b/cmuxTests/MainWindowPinTests.swift
new file mode 100644
index 00000000..22b3d69a
--- /dev/null
+++ b/cmuxTests/MainWindowPinTests.swift
@@ -0,0 +1,107 @@
+import AppKit
+import Testing
+
+#if canImport(cmux_DEV)
+@testable import cmux_DEV
+#elseif canImport(cmux)
+@testable import cmux
+#endif
+
+@MainActor
+@Suite
+struct MainWindowPinTests {
+    private func makeMainWindow() -> CmuxMainWindow {
+        let window = CmuxMainWindow(
+            contentRect: NSRect(x: 0, y: 0, width: 800, height: 600),
+            styleMask: [.titled, .closable, .resizable], backing: .buffered, defer: true
+        )
+        window.isReleasedWhenClosed = false
+        return window
+    }
+
+    @Test func mainWindowsPinIndependentlyWithoutChangingSpaces() {
+        let first = makeMainWindow()
+        let second = makeMainWindow()
+        let behavior = first.collectionBehavior
+        #expect(first.level == .normal)
+        first.pin.toggle()
+        #expect(first.level == .floating)
+        #expect(second.level == .normal)
+        second.pin.toggle()
+        first.pin.toggle()
+        #expect(first.level == .normal)
+        #expect(second.level == .floating)
+        #expect(first.collectionBehavior == behavior)
+    }
+
+    @Test func fullscreenSuspendsPinAndFailedEntryRestoresIt() {
+        let window = makeMainWindow()
+        let controller = MainWindowController(window: window)
+        let enter = Notification(name: NSWindow.willEnterFullScreenNotification, object: window)
+        window.pin.toggle()
+        controller.windowWillEnterFullScreen(enter)
+        #expect(window.pin.isPinned)
+        #expect(window.level == .normal)
+        controller.windowDidFailToEnterFullScreen(window)
+        #expect(window.level == .floating)
+        controller.windowWillEnterFullScreen(enter)
+        controller.windowDidExitFullScreen(Notification(name: NSWindow.didExitFullScreenNotification, object: window))
+        #expect(window.level == .floating)
+        controller.windowWillEnterFullScreen(enter)
+        window.pin.toggle()
+        controller.windowDidExitFullScreen(Notification(name: NSWindow.didExitFullScreenNotification, object: window))
+        #expect(window.level == .normal)
+    }
+
+    @Test func closeDetachesEvenWhenTitlebarStillReferencesPin() {
+        let window = makeMainWindow()
+        let controller = MainWindowController(window: window)
+        let pin = window.pin
+        pin.toggle()
+        controller.windowWillClose(Notification(name: NSWindow.willCloseNotification, object: window))
+        pin.toggle()
+        #expect(!pin.isPinned)
+        #expect(window.level == .normal)
+        #expect(makeMainWindow().level == .normal)
+    }
+
+    @Test func presentedPeersClearPinnedTerminalAndGiveUpTheirTemporaryLevel() {
+        let levels = CmuxPeerWindowLevels()
+        let main = makeMainWindow()
+        let settings = NSWindow()
+        settings.styleMask = [.titled, .closable]
+        let popup = NSPanel()
+        popup.styleMask = [.titled, .closable]
+        popup.level = .normal
+        main.pin.toggle()
+        levels.present(settings, overPinnedTerminal: true)
+        #expect(settings.level.rawValue > main.level.rawValue)
+        levels.present(popup, overPinnedTerminal: true)
+        #expect(settings.level == .normal)
+        #expect(popup.level.rawValue > main.level.rawValue)
+        levels.present(main, overPinnedTerminal: true)
+        #expect(popup.level == .normal)
+        #expect(main.level == .floating)
+        levels.present(settings, overPinnedTerminal: true)
+        levels.present(settings, overPinnedTerminal: false)
+        #expect(settings.level == .normal)
+    }
+
+    @Test func preservesSpecialPanelLevelsAndAttachedChildren() {
+        let levels = CmuxPeerWindowLevels()
+        let panel = NSPanel()
+        panel.styleMask = [.titled, .closable]
+        panel.level = .modalPanel
+        levels.present(panel, overPinnedTerminal: true)
+        levels.restore()
+        #expect(panel.level == .modalPanel)
+        let parent = NSWindow()
+        let child = NSWindow()
+        child.styleMask = [.titled, .closable]
+        parent.addChildWindow(child, ordered: .above)
+        defer { parent.removeChildWindow(child) }
+        let level = child.level
+        levels.present(child, overPinnedTerminal: true)
+        #expect(child.level == level)
+    }
+}
